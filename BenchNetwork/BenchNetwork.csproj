<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>BenchNetwork</AssemblyName>
    <RootNamespace>BenchNetwork</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Default version for local builds; the release workflow overrides it. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Jotunn's package also adds references to BepInEx, Harmony, Unity and the publicized game assemblies. -->
    <PackageReference Include="JotunnLib" Version="2.30.2" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="DeployToBepInEx" AfterTargets="Build" Condition="'$(BEPINEX_PATH)' != '' And Exists('$(BEPINEX_PATH)/plugins')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BEPINEX_PATH)/plugins/BenchNetwork" />
  </Target>

  <!-- BuildInfo.Version = $(Version), so the plugin, manifest and zip always carry the same version. -->
  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</BuildInfoFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(BuildInfoFile)" Lines="namespace BenchNetwork { internal static class BuildInfo { public const string Version = &quot;$(Version)&quot;%3B } }" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(BuildInfoFile)" />
      <FileWrites Include="$(BuildInfoFile)" />
    </ItemGroup>
  </Target>

  <!-- Thunderstore-format zip for Gale, r2modman or Thunderstore upload: bin/<Configuration>/BenchNetwork-<Version>.zip -->
  <PropertyGroup>
    <ThunderstoreManifest>{
  "name": "BenchNetwork",
  "version_number": "$(Version)",
  "website_url": "https://github.com/m0zzy/Bench-Network",
  "description": "Crafting stations whose range circles overlap join a network. Build, remove and repair anywhere in it as if every station type were there.",
  "dependencies": [
    "denikson-BepInExPack_Valheim-5.4.2202",
    "ValheimModding-Jotunn-2.30.2"
  ]
}</ThunderstoreManifest>
  </PropertyGroup>

  <Target Name="ThunderstorePackage" AfterTargets="Build">
    <PropertyGroup>
      <ThunderstoreStaging>$(IntermediateOutputPath)thunderstore/</ThunderstoreStaging>
    </PropertyGroup>
    <RemoveDir Directories="$(ThunderstoreStaging)" />
    <Copy SourceFiles="$(TargetPath);Package/icon.png;../README.md" DestinationFolder="$(ThunderstoreStaging)" />
    <WriteLinesToFile File="$(ThunderstoreStaging)manifest.json" Lines="$(ThunderstoreManifest)" Overwrite="true" />
    <ZipDirectory SourceDirectory="$(ThunderstoreStaging)" DestinationFile="$(OutDir)$(AssemblyName)-$(Version).zip" Overwrite="true" />
  </Target>

</Project>
